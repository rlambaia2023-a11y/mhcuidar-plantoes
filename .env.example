# ===== mhcuidar • Plantões — configuração oficial =====
# Copie para .env e preencha. Nada aqui é commitado (.gitignore protege).

PORT=3003
TIMEZONE=America/Sao_Paulo

# --- Interpretação de linguagem natural ---
DEFAULT_START_HOUR=7        # hora assumida quando o texto não diz (ex.: 7 = 07:00)
DEFAULT_SHIFT_TYPE=24h       # duração assumida quando o texto não diz (12h, 24h, 48h, 72h)
SN_HOURS=24                 # duração de um sobreaviso (SN)
KNOWN_PLACES=Clínica mhcuidar, Hospital Geral Clériston Andrade (HGCA), Hospital Estadual da Criança (HEC), Hospital da Mulher, Hospital Geral, Hospital Unimed, UPA 24h, SAMU

# --- Lembretes automáticos ---
# Janelas em minutos antes do plantão: 1440 min = 24h antes, 120 min = 2h antes
REMINDER_WINDOWS_MIN=1440,120
# Resumo diário matinal no WhatsApp às 07:00
DAILY_SUMMARY_TIME=07:00

# --- WhatsApp ---
# Provedor: agente (próprio, recomendado — roda neste servidor, sem custo por mensagem),
# callmebot (grátis), twilio ou console (só loga)
WHATSAPP_PROVIDER=agente
# Seu número com DDI+DDD, só dígitos (ex.: 5575991815612) — recebe os lembretes
WHATSAPP_NUMBER=5575991815612
# Número dono do bot (quem pode mandar comandos). Vazio = mesmo do WHATSAPP_NUMBER.
OWNER_WHATSAPP=5575991815612

# CallMeBot (alternativa opcional):
CALLMEBOT_APIKEY=

# Twilio (alternativa opcional):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Google Agenda (OAuth2) ---
# E-mail: mh.cuidarsaude@gmail.com
# Crie em https://console.cloud.google.com (ver README)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3003/api/google/callback
