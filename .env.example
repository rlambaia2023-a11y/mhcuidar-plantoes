# ===== mhcuidar • Plantões — configuração =====
# Copie para .env e preencha. Nada aqui é commitado (.gitignore protege).

PORT=3003
TIMEZONE=America/Sao_Paulo

# --- Interpretação de linguagem natural ---
DEFAULT_START_HOUR=7        # hora assumida quando o texto não diz (ex.: 7 = 07:00)
DEFAULT_SHIFT_TYPE=24h       # duração assumida quando o texto não diz (12h, 24h, 48h, 72h)
SN_HOURS=24                 # duração de um sobreaviso (SN)
KNOWN_PLACES=Clínica mhcuidar

# --- Lembretes automáticos ---
# Janelas em minutos antes do plantão (ex.: 1440 = 24h antes, 120 = 2h antes)
REMINDER_WINDOWS_MIN=1440,120
# Resumo diário opcional (formato HH:MM). Vazio = desligado.
DAILY_SUMMARY_TIME=07:00

# --- WhatsApp ---
# Provedor: callmebot (grátis, recomendado p/ uso pessoal), twilio ou console (só loga)
WHATSAPP_PROVIDER=callmebot
# Seu número com DDI+DDD, só dígitos (ex.: 5511999998888)
WHATSAPP_NUMBER=
# CallMeBot: apikey obtida após mandar "I allow callmebot to send me messages" p/ +34 644 71 27 40
CALLMEBOT_APIKEY=
# Twilio (opcional): preencha se WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Google Agenda (OAuth2) ---
# Crie em https://console.cloud.google.com (ver README). Também aceita arquivo credentials.json na raiz.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3003/api/google/callback
